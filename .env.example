# Copy this file to .env and fill in your values. .env is git-ignored — never commit it.

# Neon console → your project → Connect → copy the connection string (pooled is fine).
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Better Auth. Generate the secret with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Keep it stable: changing it signs everyone out. Required in every environment.
BETTER_AUTH_SECRET=replace-with-a-long-random-string
# Public origin of the app (no trailing slash). Defaults to http://localhost:PORT outside production; in production it
# defaults to RENDER_EXTERNAL_URL on Render and is otherwise REQUIRED.
# BETTER_AUTH_URL=https://your-app.example.com

# PORT=3000

# Optional, for `npm run render:create|deploy|autodeploy` from your machine (GitHub Actions uses repository secrets instead).
# RENDER_API_KEY=rnd_...
# RENDER_SERVICE_ID=srv-...
