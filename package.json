{
  "name": "bookstore",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.js --dev",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "prod": "npm run build && npm start",
    "db:reset": "node --env-file-if-exists=.env server/db-reset.js",
    "render:create": "node --env-file-if-exists=.env scripts/render.mjs create",
    "render:deploy": "node --env-file-if-exists=.env scripts/render.mjs deploy",
    "render:autodeploy": "node --env-file-if-exists=.env scripts/render.mjs autodeploy"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "better-auth": "1.7.13",
    "express": "5.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "vite": "5.4.11"
  }
}
